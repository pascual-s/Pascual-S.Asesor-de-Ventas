<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catálogo de Productos</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background: #f4f4f4; color: #333; }
        header { text-align: center; margin-bottom: 30px; }
        .grid { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; }
        .card { background: white; padding: 15px; border-radius: 8px; width: 220px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); text-align: center; }
        .card img { max-width: 100%; height: 150px; object-fit: cover; border-radius: 4px; }
        .price { color: #007bff; font-weight: bold; margin: 10px 0; }
        .btn { background: #28a745; color: white; padding: 8px 12px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; }
    </style>
</head>
<body>

    <header>
        <h1>Mi Catálogo Online</h1>
        <p>Explora nuestros productos destacados</p>
    </header>

    <div class="grid">
        <div class="card">
            <img src="https://via.placeholder.com/150" alt="Producto 1">
            <h3>Producto Ejemplo 1</h3>
            <p class="price">Gs. 150.000</p>
            <a href="#" class="btn">Consultar</a>
        </div>

        <div class="card">
            <img src="https://via.placeholder.com/150" alt="Producto 2">
            <h3>Producto Ejemplo 2</h3>
            <p class="price">Gs. 250.000</p>
            <a href="#" class="btn">Consultar</a>
        </div>
    </div>

</body>
</html>
